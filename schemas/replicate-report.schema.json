{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detection Threshold Lab replicate report",
  "type": "object",
  "required": [
    "schema",
    "seeds",
    "groups",
    "samples",
    "thresholds",
    "aggregate",
    "runs"
  ],
  "properties": {
    "schema": {
      "const": "lr-detection-lab-replicate/v1"
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer"
      }
    },
    "groups": {
      "type": "integer",
      "minimum": 2
    },
    "samples": {
      "type": "integer",
      "minimum": 3
    },
    "thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "aggregate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "threshold",
          "runs"
        ],
        "properties": {
          "threshold": {
            "type": "number"
          },
          "runs": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seed",
          "evaluated_groups",
          "sweep"
        ]
      }
    }
  }
}
